{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EVEO Optimized Skill — frontmatter schema",
  "type": "object",
  "required": ["name", "description", "version", "category", "keywords"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Nome da skill em kebab-case"
    },
    "description": {
      "type": "string",
      "minLength": 50,
      "maxLength": 600,
      "description": "Descricao otimizada para trigger. Inclua O QUE faz + STACK + QUANDO acionar (keywords/gatilhos). Estilo pushy para evitar undertriggering."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic versioning"
    },
    "category": {
      "type": "string",
      "enum": ["Backend", "Frontend", "Cloud", "Database", "Infra", "Security", "DevSecOps", "Service-NoSQL", "Crosscutting", "Outras"]
    },
    "keywords": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 2 }
    },
    "requires": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "description": "Skills das quais esta depende. Cada item deve resolver para uma skill existente no corpus."
    }
  }
}
